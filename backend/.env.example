DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.nstore.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.nstore.kz
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_COOKIE_SECURE=true
DJANGO_HSTS_SECONDS=31536000

POSTGRES_DB=nstore
POSTGRES_USER=nstore
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0

# Read-only OData access. Never commit real credentials.
ONEC_BASE_URL=https://example.invalid/UN_JJCO/odata/standard.odata
ONEC_USERNAME=replace-me
ONEC_PASSWORD=replace-me
ONEC_VERIFY_TLS=true
# HTTP service returning raw attached-file bytes. Available placeholders:
# {file_ref}, {owner_ref}. Keep empty until the 1C HTTP service is published.
ONEC_MEDIA_URL_TEMPLATE=https://example.invalid/UN_JJCO/hs/nstore-media/file/{file_ref}
ONEC_IMAGE_MAX_SIDE=1600
ONEC_IMAGE_WEBP_QUALITY=82
ONEC_RETAIL_PRICE_TYPE_ID=6030d2d3-83af-11ed-99d5-b48c9d55801d
ONEC_B2B_PRICE_TYPE_IDS=9a002745-81fb-11ed-99cd-b48c9d55801d,b1b63718-a48a-11ee-b24d-30c9abdd6710
# Explicit allowlist; empty means all warehouses and is not recommended for production.
ONEC_WAREHOUSE_IDS=

# disabled keeps orders in the durable outbox until the real CRM contract is supplied.
CRM_MODE=disabled
CRM_BASE_URL=https://crm.example.invalid/api
CRM_TOKEN=replace-me
CRM_VERIFY_TLS=true
