# Supabase (frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Источник каталога /shop: django | supabase (временно по умолчанию) | demo
NEXT_PUBLIC_CATALOG_SOURCE=
# Обычно пусто: Next.js проксирует same-origin /api. Нужен только отдельный API origin.
NEXT_PUBLIC_DJANGO_API_URL=

# Supabase (server-side: sync_1c_products.py, sync_products_ascii.py,
# push_orders_to_1c.py, api/track.ts)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role — только для скриптов, которым нужна запись в products в обход RLS
# (sync_1c_products.py). Секрет, никогда не используется в клиенте/фронтенде.
SUPABASE_SERVICE_KEY=

# Yandex Maps
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Cloudinary (опционально)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-only Django upstream for same-origin /api proxy
DJANGO_API_ORIGIN=http://127.0.0.1:8000
