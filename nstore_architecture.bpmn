<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://nstore.kz/bpmn"
             id="NstoreArchitecture">

  <!-- ═══════════════════════════════════════════════════
       POOL 1: КЛИЕНТСКИЙ ПОТОК (Авторизация + Кабинет)
       ═══════════════════════════════════════════════════ -->
  <collaboration id="NstoreCollaboration">

    <participant id="pool_client" name="Клиент" processRef="proc_client" />
    <participant id="pool_manager" name="Менеджер / Логист / Админ (CRM)" processRef="proc_crm" />
    <participant id="pool_system" name="Система (Edge Functions + Supabase)" processRef="proc_system" />
    <participant id="pool_whatsapp" name="WhatsApp Business API" processRef="proc_wa" />

    <!-- Message Flows -->
    <messageFlow id="mf1" sourceRef="task_client_request_otp" targetRef="task_ef_otp_send" name="phone number" />
    <messageFlow id="mf2" sourceRef="task_ef_otp_send" targetRef="event_wa_otp_received" name="OTP code via WA" />
    <messageFlow id="mf3" sourceRef="task_client_verify_otp" targetRef="task_ef_otp_verify" name="phone + code" />
    <messageFlow id="mf4" sourceRef="task_ef_otp_verify" targetRef="event_client_logged_in" name="session token" />

    <messageFlow id="mf5" sourceRef="task_wa_incoming" targetRef="task_ef_webhook" name="incoming message" />
    <messageFlow id="mf6" sourceRef="task_crm_send_wa" targetRef="task_ef_wa_send" name="message payload" />
    <messageFlow id="mf7" sourceRef="task_ef_wa_send" targetRef="task_wa_deliver" name="send API call" />

    <messageFlow id="mf8" sourceRef="task_crm_create_order" targetRef="task_sys_save_order" name="order data" />
    <messageFlow id="mf9" sourceRef="task_sys_save_order" targetRef="event_order_created" name="order_id" />
  </collaboration>

  <!-- ═══════════════════════════
       PROCESS 1: КЛИЕНТ
       ═══════════════════════════ -->
  <process id="proc_client" name="Клиент" isExecutable="false">

    <!-- START: Открывает сайт -->
    <startEvent id="start_client" name="Открывает сайт /cabinet">
      <outgoing>sf_c1</outgoing>
    </startEvent>

    <!-- Gateway: авторизован? -->
    <exclusiveGateway id="gw_client_auth" name="Авторизован?">
      <incoming>sf_c1</incoming>
      <outgoing>sf_c2</outgoing>
      <outgoing>sf_c3</outgoing>
    </exclusiveGateway>

    <!-- Запрос OTP -->
    <task id="task_client_request_otp" name="Вводит номер телефона&#10;(запрос OTP)">
      <incoming>sf_c2</incoming>
      <outgoing>sf_c4</outgoing>
    </task>

    <!-- Ждёт WA сообщения -->
    <intermediateCatchEvent id="event_wa_otp_received" name="Получает OTP в WhatsApp">
      <incoming>sf_c4</incoming>
      <outgoing>sf_c5</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>

    <!-- Вводит OTP -->
    <task id="task_client_verify_otp" name="Вводит OTP код">
      <incoming>sf_c5</incoming>
      <outgoing>sf_c6</outgoing>
    </task>

    <!-- Авторизован -->
    <intermediateCatchEvent id="event_client_logged_in" name="Получает сессию">
      <incoming>sf_c6</incoming>
      <outgoing>sf_c7</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>

    <!-- В кабинете -->
    <task id="task_client_cabinet" name="Личный кабинет /cabinet&#10;(заказы, продукты, профиль)">
      <incoming>sf_c3</incoming>
      <incoming>sf_c7</incoming>
      <outgoing>sf_c8</outgoing>
    </task>

    <!-- Просматривает каталог -->
    <task id="task_client_catalog" name="Просматривает каталог&#10;(products: 1229 SKU)">
      <incoming>sf_c8</incoming>
      <outgoing>sf_c9</outgoing>
    </task>

    <!-- Оформляет заказ -->
    <task id="task_client_order" name="Оформляет заказ">
      <incoming>sf_c9</incoming>
      <outgoing>sf_c10</outgoing>
    </task>

    <!-- Отслеживает статус -->
    <task id="task_client_track" name="Отслеживает статус заявки&#10;(new→confirmed→picking→delivering→done)">
      <incoming>sf_c10</incoming>
      <outgoing>sf_c_end</outgoing>
    </task>

    <endEvent id="end_client" name="Заказ выполнен">
      <incoming>sf_c_end</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="sf_c1" sourceRef="start_client" targetRef="gw_client_auth" />
    <sequenceFlow id="sf_c2" sourceRef="gw_client_auth" targetRef="task_client_request_otp" name="Нет" />
    <sequenceFlow id="sf_c3" sourceRef="gw_client_auth" targetRef="task_client_cabinet" name="Да" />
    <sequenceFlow id="sf_c4" sourceRef="task_client_request_otp" targetRef="event_wa_otp_received" />
    <sequenceFlow id="sf_c5" sourceRef="event_wa_otp_received" targetRef="task_client_verify_otp" />
    <sequenceFlow id="sf_c6" sourceRef="task_client_verify_otp" targetRef="event_client_logged_in" />
    <sequenceFlow id="sf_c7" sourceRef="event_client_logged_in" targetRef="task_client_cabinet" />
    <sequenceFlow id="sf_c8" sourceRef="task_client_cabinet" targetRef="task_client_catalog" />
    <sequenceFlow id="sf_c9" sourceRef="task_client_catalog" targetRef="task_client_order" />
    <sequenceFlow id="sf_c10" sourceRef="task_client_order" targetRef="task_client_track" />
    <sequenceFlow id="sf_c_end" sourceRef="task_client_track" targetRef="end_client" />
  </process>

  <!-- ═══════════════════════════
       PROCESS 2: CRM (Сотрудники)
       ═══════════════════════════ -->
  <process id="proc_crm" name="CRM" isExecutable="false">

    <startEvent id="start_crm" name="Открывает CRM /crm">
      <outgoing>sf_crm1</outgoing>
    </startEvent>

    <!-- Дашборд -->
    <task id="task_crm_dash" name="Дашборд&#10;(KPI: выручка, заявки,&#10;конверсия, задачи)">
      <incoming>sf_crm1</incoming>
      <outgoing>sf_crm2</outgoing>
    </task>

    <!-- Gateway: выбор вкладки -->
    <exclusiveGateway id="gw_crm_tab" name="Выбор раздела">
      <incoming>sf_crm2</incoming>
      <outgoing>sf_crm_orders</outgoing>
      <outgoing>sf_crm_board</outgoing>
      <outgoing>sf_crm_clients</outgoing>
      <outgoing>sf_crm_logistics</outgoing>
      <outgoing>sf_crm_wa</outgoing>
      <outgoing>sf_crm_content</outgoing>
      <outgoing>sf_crm_roles</outgoing>
    </exclusiveGateway>

    <!-- Заявки -->
    <subProcess id="sub_orders" name="Заявки (Orders)&#10;crm_tasks [task_type=order]">
      <incoming>sf_crm_orders</incoming>
      <outgoing>sf_crm_merge</outgoing>

      <startEvent id="start_sub_orders"><outgoing>sf_so1</outgoing></startEvent>

      <task id="task_crm_list_orders" name="Список заявок&#10;(фильтр по статусу FSM)">
        <incoming>sf_so1</incoming>
        <outgoing>sf_so2</outgoing>
      </task>

      <task id="task_crm_create_order" name="Создать заявку&#10;(client_name, phone,&#10;address, total, items JSONB)">
        <incoming>sf_so2</incoming>
        <outgoing>sf_so3</outgoing>
      </task>

      <task id="task_crm_change_status" name="Изменить статус заявки&#10;new→confirmed→picking&#10;→delivering→done/cancelled">
        <incoming>sf_so3</incoming>
        <outgoing>sf_so_end</outgoing>
      </task>

      <endEvent id="end_sub_orders"><incoming>sf_so_end</incoming></endEvent>

      <sequenceFlow id="sf_so1" sourceRef="start_sub_orders" targetRef="task_crm_list_orders" />
      <sequenceFlow id="sf_so2" sourceRef="task_crm_list_orders" targetRef="task_crm_create_order" />
      <sequenceFlow id="sf_so3" sourceRef="task_crm_create_order" targetRef="task_crm_change_status" />
      <sequenceFlow id="sf_so_end" sourceRef="task_crm_change_status" targetRef="end_sub_orders" />
    </subProcess>

    <!-- Kanban доска -->
    <subProcess id="sub_board" name="Доска (Board)&#10;crm_projects → crm_columns → crm_tasks">
      <incoming>sf_crm_board</incoming>
      <outgoing>sf_crm_merge</outgoing>

      <startEvent id="start_sub_board"><outgoing>sf_sb1</outgoing></startEvent>

      <task id="task_crm_kanban" name="Kanban доска&#10;(drag-and-drop задач&#10;по колонкам)">
        <incoming>sf_sb1</incoming>
        <outgoing>sf_sb2</outgoing>
      </task>

      <task id="task_crm_task_detail" name="Детали задачи&#10;(комментарии, вложения,&#10;assignee, due_date)">
        <incoming>sf_sb2</incoming>
        <outgoing>sf_sb_end</outgoing>
      </task>

      <endEvent id="end_sub_board"><incoming>sf_sb_end</incoming></endEvent>

      <sequenceFlow id="sf_sb1" sourceRef="start_sub_board" targetRef="task_crm_kanban" />
      <sequenceFlow id="sf_sb2" sourceRef="task_crm_kanban" targetRef="task_crm_task_detail" />
      <sequenceFlow id="sf_sb_end" sourceRef="task_crm_task_detail" targetRef="end_sub_board" />
    </subProcess>

    <!-- Клиенты -->
    <subProcess id="sub_clients" name="Клиенты&#10;profiles + contacts + companies + locations">
      <incoming>sf_crm_clients</incoming>
      <outgoing>sf_crm_merge</outgoing>

      <startEvent id="start_sub_clients"><outgoing>sf_sc1</outgoing></startEvent>

      <task id="task_crm_clients_list" name="Список клиентов&#10;(contacts: 2098)">
        <incoming>sf_sc1</incoming>
        <outgoing>sf_sc2</outgoing>
      </task>

      <task id="task_crm_companies" name="Компании&#10;(companies: 154)&#10;Сегмент: horeca/office/&#10;wholesale/pharmacy/shop">
        <incoming>sf_sc2</incoming>
        <outgoing>sf_sc3</outgoing>
      </task>

      <task id="task_crm_locations" name="Точки доставки&#10;(locations: 9)&#10;owner → company">
        <incoming>sf_sc3</incoming>
        <outgoing>sf_sc_end</outgoing>
      </task>

      <endEvent id="end_sub_clients"><incoming>sf_sc_end</incoming></endEvent>

      <sequenceFlow id="sf_sc1" sourceRef="start_sub_clients" targetRef="task_crm_clients_list" />
      <sequenceFlow id="sf_sc2" sourceRef="task_crm_clients_list" targetRef="task_crm_companies" />
      <sequenceFlow id="sf_sc3" sourceRef="task_crm_companies" targetRef="task_crm_locations" />
      <sequenceFlow id="sf_sc_end" sourceRef="task_crm_locations" targetRef="end_sub_clients" />
    </subProcess>

    <!-- Логистика -->
    <subProcess id="sub_logistics" name="Логистика&#10;Маршруты курьеров">
      <incoming>sf_crm_logistics</incoming>
      <outgoing>sf_crm_merge</outgoing>

      <startEvent id="start_sub_log"><outgoing>sf_sl1</outgoing></startEvent>

      <task id="task_crm_routes" name="Маршруты курьеров&#10;(список остановок,&#10;статусы: done/going/waiting)">
        <incoming>sf_sl1</incoming>
        <outgoing>sf_sl2</outgoing>
      </task>

      <task id="task_crm_map" name="Карта маршрута&#10;(пройдено / осталось)">
        <incoming>sf_sl2</incoming>
        <outgoing>sf_sl_end</outgoing>
      </task>

      <endEvent id="end_sub_log"><incoming>sf_sl_end</incoming></endEvent>

      <sequenceFlow id="sf_sl1" sourceRef="start_sub_log" targetRef="task_crm_routes" />
      <sequenceFlow id="sf_sl2" sourceRef="task_crm_routes" targetRef="task_crm_map" />
      <sequenceFlow id="sf_sl_end" sourceRef="task_crm_map" targetRef="end_sub_log" />
    </subProcess>

    <!-- WhatsApp CRM -->
    <task id="task_crm_send_wa" name="WhatsApp чат&#10;(wa_conversations + wa_messages)&#10;Отправить сообщение клиенту">
      <incoming>sf_crm_wa</incoming>
      <outgoing>sf_crm_merge</outgoing>
    </task>

    <!-- Контент -->
    <task id="task_crm_content_edit" name="Редактор контента&#10;site_content: banner/promo/&#10;quick_action/advantage/review&#10;page_blocks: JSONB">
      <incoming>sf_crm_content</incoming>
      <outgoing>sf_crm_merge</outgoing>
    </task>

    <!-- Роли -->
    <task id="task_crm_roles" name="Роли и доступ&#10;profiles.role: admin/manager/&#10;logist/client&#10;Матрица прав 10×4">
      <incoming>sf_crm_roles</incoming>
      <outgoing>sf_crm_merge</outgoing>
    </task>

    <!-- Merge gateway -->
    <exclusiveGateway id="gw_crm_merge" name="Назад в дашборд">
      <incoming>sf_crm_merge</incoming>
      <outgoing>sf_crm_back</outgoing>
    </exclusiveGateway>

    <endEvent id="end_crm" name="Сессия завершена">
      <incoming>sf_crm_back</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="sf_crm1" sourceRef="start_crm" targetRef="task_crm_dash" />
    <sequenceFlow id="sf_crm2" sourceRef="task_crm_dash" targetRef="gw_crm_tab" />
    <sequenceFlow id="sf_crm_orders" sourceRef="gw_crm_tab" targetRef="sub_orders" name="Заявки" />
    <sequenceFlow id="sf_crm_board" sourceRef="gw_crm_tab" targetRef="sub_board" name="Доска" />
    <sequenceFlow id="sf_crm_clients" sourceRef="gw_crm_tab" targetRef="sub_clients" name="Клиенты" />
    <sequenceFlow id="sf_crm_logistics" sourceRef="gw_crm_tab" targetRef="sub_logistics" name="Логистика" />
    <sequenceFlow id="sf_crm_wa" sourceRef="gw_crm_tab" targetRef="task_crm_send_wa" name="WhatsApp" />
    <sequenceFlow id="sf_crm_content" sourceRef="gw_crm_tab" targetRef="task_crm_content_edit" name="Контент" />
    <sequenceFlow id="sf_crm_roles" sourceRef="gw_crm_tab" targetRef="task_crm_roles" name="Роли" />
    <sequenceFlow id="sf_crm_merge" sourceRef="sub_orders" targetRef="gw_crm_merge" />
    <sequenceFlow id="sf_crm_back" sourceRef="gw_crm_merge" targetRef="end_crm" />
  </process>

  <!-- ═══════════════════════════
       PROCESS 3: EDGE FUNCTIONS
       ═══════════════════════════ -->
  <process id="proc_system" name="Система" isExecutable="false">

    <startEvent id="start_sys" name="Входящий запрос">
      <outgoing>sf_sys1</outgoing>
    </startEvent>

    <exclusiveGateway id="gw_sys_route" name="Маршрут">
      <incoming>sf_sys1</incoming>
      <outgoing>sf_sys_otp</outgoing>
      <outgoing>sf_sys_verify</outgoing>
      <outgoing>sf_sys_send</outgoing>
      <outgoing>sf_sys_webhook</outgoing>
    </exclusiveGateway>

    <!-- OTP Send -->
    <task id="task_ef_otp_send" name="whatsapp-otp&#10;(без JWT)&#10;1. Генерирует 6-цифр код&#10;2. Сохраняет в wa_otp&#10;3. Отправляет через WA API">
      <incoming>sf_sys_otp</incoming>
      <outgoing>sf_sys_otp_end</outgoing>
    </task>

    <!-- OTP Verify -->
    <task id="task_ef_otp_verify" name="whatsapp-otp-verify&#10;(без JWT)&#10;1. Проверяет wa_otp&#10;2. Помечает used=true&#10;3. Создаёт/находит auth.user&#10;4. Возвращает session">
      <incoming>sf_sys_verify</incoming>
      <outgoing>sf_sys_verify_end</outgoing>
    </task>

    <!-- WA Send -->
    <task id="task_ef_wa_send" name="whatsapp-send&#10;(с JWT)&#10;1. Проверяет роль менеджера&#10;2. Отправляет сообщение&#10;3. Сохраняет в wa_messages">
      <incoming>sf_sys_send</incoming>
      <outgoing>sf_sys_send_end</outgoing>
    </task>

    <!-- WA Webhook -->
    <task id="task_ef_webhook" name="whatsapp-webhook&#10;(без JWT)&#10;1. Принимает events от WA&#10;2. Upsert wa_conversations&#10;3. Insert wa_messages&#10;4. Обновляет unread_count">
      <incoming>sf_sys_webhook</incoming>
      <outgoing>sf_sys_webhook_end</outgoing>
    </task>

    <!-- DB Operations -->
    <subProcess id="sub_db" name="Supabase PostgreSQL 17&#10;(RLS на всех таблицах)">
      <incoming>sf_sys_otp_end</incoming>
      <incoming>sf_sys_verify_end</incoming>
      <incoming>sf_sys_send_end</incoming>
      <incoming>sf_sys_webhook_end</incoming>
      <outgoing>sf_sys_db_end</outgoing>

      <startEvent id="start_db"><outgoing>sf_db1</outgoing></startEvent>

      <parallelGateway id="gw_db_tables" name="Таблицы БД">
        <incoming>sf_db1</incoming>
        <outgoing>sf_db_profiles</outgoing>
        <outgoing>sf_db_crm</outgoing>
        <outgoing>sf_db_wa</outgoing>
        <outgoing>sf_db_catalog</outgoing>
        <outgoing>sf_db_content</outgoing>
      </parallelGateway>

      <task id="task_db_profiles" name="Пользователи&#10;profiles (9)&#10;contracts (2)&#10;discounts (0)&#10;invites (4)&#10;kpi_goals (2)">
        <incoming>sf_db_profiles</incoming>
        <outgoing>sf_db_merge</outgoing>
      </task>

      <task id="task_db_crm" name="CRM&#10;companies (154)&#10;contacts (2098)&#10;locations (9)&#10;crm_projects (3)&#10;crm_columns (10)&#10;crm_tasks (17)&#10;crm_task_comments (4)">
        <incoming>sf_db_crm</incoming>
        <outgoing>sf_db_merge</outgoing>
      </task>

      <task id="task_db_wa" name="WhatsApp&#10;wa_conversations (1)&#10;wa_messages (5)&#10;wa_otp (2)">
        <incoming>sf_db_wa</incoming>
        <outgoing>sf_db_merge</outgoing>
      </task>

      <task id="task_db_catalog" name="Каталог&#10;products (1229 SKU)&#10;(price, price_tp, stock,&#10;onec_ref, section)">
        <incoming>sf_db_catalog</incoming>
        <outgoing>sf_db_merge</outgoing>
      </task>

      <task id="task_db_content" name="Контент&#10;site_content (13)&#10;page_blocks (9 JSONB)">
        <incoming>sf_db_content</incoming>
        <outgoing>sf_db_merge</outgoing>
      </task>

      <parallelGateway id="gw_db_merge" name="Merge">
        <incoming>sf_db_merge</incoming>
        <outgoing>sf_db_end</outgoing>
      </parallelGateway>

      <endEvent id="end_db"><incoming>sf_db_end</incoming></endEvent>

      <sequenceFlow id="sf_db1" sourceRef="start_db" targetRef="gw_db_tables" />
      <sequenceFlow id="sf_db_profiles" sourceRef="gw_db_tables" targetRef="task_db_profiles" />
      <sequenceFlow id="sf_db_crm" sourceRef="gw_db_tables" targetRef="task_db_crm" />
      <sequenceFlow id="sf_db_wa" sourceRef="gw_db_tables" targetRef="task_db_wa" />
      <sequenceFlow id="sf_db_catalog" sourceRef="gw_db_tables" targetRef="task_db_catalog" />
      <sequenceFlow id="sf_db_content" sourceRef="gw_db_tables" targetRef="task_db_content" />
      <sequenceFlow id="sf_db_merge" sourceRef="task_db_profiles" targetRef="gw_db_merge" />
      <sequenceFlow id="sf_db_end" sourceRef="gw_db_merge" targetRef="end_db" />
    </subProcess>

    <!-- Save order event -->
    <task id="task_sys_save_order" name="Сохранить заявку&#10;INSERT crm_tasks&#10;(task_type=order)">
      <outgoing>sf_sys_order_saved</outgoing>
    </task>

    <intermediateCatchEvent id="event_order_created" name="Заявка создана">
      <incoming>sf_sys_order_saved</incoming>
      <outgoing>sf_sys_end</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>

    <endEvent id="end_sys" name="Ответ отправлен">
      <incoming>sf_sys_db_end</incoming>
      <incoming>sf_sys_end</incoming>
    </endEvent>

    <sequenceFlow id="sf_sys1" sourceRef="start_sys" targetRef="gw_sys_route" />
    <sequenceFlow id="sf_sys_otp" sourceRef="gw_sys_route" targetRef="task_ef_otp_send" name="POST /whatsapp-otp" />
    <sequenceFlow id="sf_sys_verify" sourceRef="gw_sys_route" targetRef="task_ef_otp_verify" name="POST /whatsapp-otp-verify" />
    <sequenceFlow id="sf_sys_send" sourceRef="gw_sys_route" targetRef="task_ef_wa_send" name="POST /whatsapp-send" />
    <sequenceFlow id="sf_sys_webhook" sourceRef="gw_sys_route" targetRef="task_ef_webhook" name="POST /whatsapp-webhook" />
    <sequenceFlow id="sf_sys_otp_end" sourceRef="task_ef_otp_send" targetRef="sub_db" />
    <sequenceFlow id="sf_sys_verify_end" sourceRef="task_ef_otp_verify" targetRef="sub_db" />
    <sequenceFlow id="sf_sys_send_end" sourceRef="task_ef_wa_send" targetRef="sub_db" />
    <sequenceFlow id="sf_sys_webhook_end" sourceRef="task_ef_webhook" targetRef="sub_db" />
    <sequenceFlow id="sf_sys_db_end" sourceRef="sub_db" targetRef="end_sys" />
    <sequenceFlow id="sf_sys_order_saved" sourceRef="task_sys_save_order" targetRef="event_order_created" />
    <sequenceFlow id="sf_sys_end" sourceRef="event_order_created" targetRef="end_sys" />
  </process>

  <!-- ═══════════════════════════
       PROCESS 4: WHATSAPP API
       ═══════════════════════════ -->
  <process id="proc_wa" name="WhatsApp Business API" isExecutable="false">

    <startEvent id="start_wa" name="WhatsApp Business API">
      <outgoing>sf_wa1</outgoing>
    </startEvent>

    <parallelGateway id="gw_wa_split" name="Направления">
      <incoming>sf_wa1</incoming>
      <outgoing>sf_wa_in</outgoing>
      <outgoing>sf_wa_out</outgoing>
    </parallelGateway>

    <task id="task_wa_incoming" name="Входящее сообщение&#10;от клиента">
      <incoming>sf_wa_in</incoming>
      <outgoing>sf_wa_in_end</outgoing>
    </task>

    <task id="task_wa_deliver" name="Доставка исходящего&#10;сообщения клиенту">
      <incoming>sf_wa_out</incoming>
      <outgoing>sf_wa_out_end</outgoing>
    </task>

    <parallelGateway id="gw_wa_merge">
      <incoming>sf_wa_in_end</incoming>
      <incoming>sf_wa_out_end</incoming>
      <outgoing>sf_wa_end</outgoing>
    </parallelGateway>

    <endEvent id="end_wa"><incoming>sf_wa_end</incoming></endEvent>

    <sequenceFlow id="sf_wa1" sourceRef="start_wa" targetRef="gw_wa_split" />
    <sequenceFlow id="sf_wa_in" sourceRef="gw_wa_split" targetRef="task_wa_incoming" />
    <sequenceFlow id="sf_wa_out" sourceRef="gw_wa_split" targetRef="task_wa_deliver" />
    <sequenceFlow id="sf_wa_in_end" sourceRef="task_wa_incoming" targetRef="gw_wa_merge" />
    <sequenceFlow id="sf_wa_out_end" sourceRef="task_wa_deliver" targetRef="gw_wa_merge" />
    <sequenceFlow id="sf_wa_end" sourceRef="gw_wa_merge" targetRef="end_wa" />
  </process>

