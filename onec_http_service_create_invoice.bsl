// onec_http_service_create_invoice.bsl
//
// Модуль HTTP-сервиса для 1С:УТ — создаёт документ "Реализация товаров и услуг"
// по заказу из CRM. Этот код НЕ проходит через прокси MCP Toolkit и его фильтр
// ключевых слов (execute_code) — он публикуется один раз в самой 1С через
// Конфигуратор и дальше работает как обычный веб-сервис.
//
// КАК ОПУБЛИКОВАТЬ (Амандосу, в Конфигураторе):
//   1. Добавить объект метаданных: HTTP-сервисы → новый сервис,
//      например "CRM_Заказы".
//   2. Корневой URL сервиса: crm_orders
//   3. Добавить URL-шаблон, например с именем "Invoice":
//        Шаблон: invoice
//        Метод: POST
//        Обработчик: СоздатьРеализацию
//   4. Весь код ниже — это модуль этого HTTP-сервиса (вкладка "Модуль").
//   5. Обновить конфигурацию базы данных, убедиться что публикация базы
//      как веб-сервиса включает новый HTTP-сервис (стандартный чек-бокс
//      в мастере публикации / файле default.vrd).
//   6. Итоговый адрес будет вида:
//        http://<хост>:<порт>/<имя_базы>/hs/crm_orders/invoice
//      Его нужно указать в push_orders_to_1c.py в ONEC_HTTP_SERVICE_URL.
//   7. Если публикация 1С требует аутентификацию (обычно требует — это
//      финансовые документы) — создать отдельного технического пользователя
//      1С с минимально нужными правами (создание Реализации, Контрагентов,
//      чтение Номенклатуры/Организаций/Складов) и указать его логин/пароль
//      в push_orders_to_1c.py (ONEC_HTTP_USER / ONEC_HTTP_PASSWORD).
//
// ПЕРЕД ПУБЛИКАЦИЕЙ: заполните ниже ИмяОрганизации/ИмяСклада точными
// значениями из Справочник.Организации / Справочник.Склады.

Функция СоздатьРеализацию(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина); // Истина = читать объекты как Соответствие
		ЧтениеJSON.Закрыть();

		ВнешнийId  = Данные.Получить("external_id");
		ИмяКлиента = Данные.Получить("client_name");
		Позиции    = Данные.Получить("items");

		Если ВнешнийId = Неопределено ИЛИ СокрЛП(ВнешнийId) = "" Тогда
			ВызватьИсключение "external_id не заполнен";
		КонецЕсли;
		Если ИмяКлиента = Неопределено ИЛИ СокрЛП(ИмяКлиента) = "" Тогда
			ВызватьИсключение "client_name не заполнен";
		КонецЕсли;
		Если Позиции = Неопределено ИЛИ Позиции.Количество() = 0 Тогда
			ВызватьИсключение "items пустой — нечего проводить";
		КонецЕсли;

		// Идемпотентность: если документ с таким external_id уже создавался
		// (например, предыдущий вызов провёлся, но ответ до Python не дошёл
		// из-за таймаута сети) — не создаём дубль, а возвращаем существующий номер.
		СуществующийНомер = НайтиСуществующийДокументПоВнешнемуId(ВнешнийId);
		Если СуществующийНомер <> Неопределено Тогда
			Ответ.УстановитьТелоИзСтроки(СтруктураВJSON(РезультатУспех(СуществующийНомер)),
				КодировкаТекста.UTF8, Ложь);
			Возврат Ответ;
		КонецЕсли;

		Организация = НайтиОрганизациюПоИмени("ЗАПОЛНИТЕ ИМЯ ОРГАНИЗАЦИИ");
		Склад       = НайтиСкладПоИмени("Алаш");
		Контрагент  = НайтиИлиСоздатьКонтрагента(ИмяКлиента);

		Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Документ.Дата = ТекущаяДата();
		Документ.Организация = Организация;
		Документ.Склад = Склад;
		Документ.Контрагент = Контрагент;
		Документ.Комментарий = "CRM:" + ВнешнийId;

		Для Каждого Поз Из Позиции Цикл
			Артикул    = Поз.Получить("sku");
			Количество = Поз.Получить("qty");
			Цена       = Поз.Получить("price");

			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Номенклатура = НайтиНоменклатуруПоАртикулу(Артикул);
			СтрокаТовары.Количество = Количество;
			СтрокаТовары.Цена = Цена;
			СтрокаТовары.Сумма = Количество * Цена;
		КонецЦикла;

		// TODO: если конфигурация требует ДоговорКонтрагента —
		// Документ.ДоговорКонтрагента = НайтиИлиСоздатьДоговор(Контрагент);

		Документ.Записать(РежимЗаписиДокумента.Проведение);

		Ответ.УстановитьТелоИзСтроки(СтруктураВJSON(РезультатУспех(Документ.Номер)),
			КодировкаТекста.UTF8, Ложь);

	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки(СтруктураВJSON(РезультатОшибка(ОписаниеОшибки())),
			КодировкаТекста.UTF8, Ложь);
	КонецПопытки;

	Возврат Ответ;
КонецФункции

Функция РезультатУспех(Знач Номер)
	Рез = Новый Структура;
	Рез.Вставить("success", Истина);
	Рез.Вставить("invoice_no", Номер);
	Возврат Рез;
КонецФункции

Функция РезультатОшибка(Знач Текст)
	Рез = Новый Структура;
	Рез.Вставить("success", Ложь);
	Рез.Вставить("error", Текст);
	Возврат Рез;
КонецФункции

Функция СтруктураВJSON(Знач Структура)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Структура);
	Возврат Запись.Закрыть();
КонецФункции

Функция НайтиСуществующийДокументПоВнешнемуId(Знач ВнешнийId)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Док.Номер КАК Номер
	|ИЗ Документ.РеализацияТоваровУслуг КАК Док
	|ГДЕ Док.Комментарий ПОДОБНО &Маска";
	Запрос.УстановитьПараметр("Маска", "%CRM:" + ВнешнийId + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номер;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиИлиСоздатьКонтрагента(Знач Наименование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Контр.Ссылка КАК Ссылка
	|ИЗ Справочник.Контрагенты КАК Контр
	|ГДЕ Контр.Наименование = &Имя И НЕ Контр.DeletionMark";
	Запрос.УстановитьПараметр("Имя", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Новый = Справочники.Контрагенты.СоздатьЭлемент();
	Новый.Наименование = Наименование;
	Новый.Записать();
	Возврат Новый.Ссылка;
КонецФункции

Функция НайтиНоменклатуруПоАртикулу(Знач Артикул)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ном.Ссылка КАК Ссылка
	|ИЗ Справочник.Номенклатура КАК Ном
	|ГДЕ Ном.Артикул = &Артикул И НЕ Ном.DeletionMark";
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Не найдена номенклатура по артикулу: " + Артикул;
КонецФункции

Функция НайтиОрганизациюПоИмени(Знач Наименование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Орг.Ссылка КАК Ссылка
	|ИЗ Справочник.Организации КАК Орг
	|ГДЕ Орг.Наименование = &Имя И НЕ Орг.DeletionMark";
	Запрос.УстановитьПараметр("Имя", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Не найдена организация: " + Наименование;
КонецФункции

Функция НайтиСкладПоИмени(Знач Наименование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Скл.Ссылка КАК Ссылка
	|ИЗ Справочник.Склады КАК Скл
	|ГДЕ Скл.Наименование = &Имя И НЕ Скл.DeletionMark";
	Запрос.УстановитьПараметр("Имя", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Не найден склад: " + Наименование;
КонецФункции
