// onec_extension_delivery.bsl
//
// Расширение 1С:УНФ «nStoreДоставка» — HTTP-сервис приёма статусов доставки из nStore CRM.
// Водитель в CRM отмечает накладную (В пути / Доставлено / Возврат) и фотографирует
// подписанную накладную; функция Supabase delivery-to-onec отправляет сюда:
//
//   POST /hs/nstore_delivery/status
//   { "ref": "<Ref_Key расходной накладной>", "number": "БКНФ-008275",
//     "status": "waiting|taken|delivered|returned", "driver": "Әділет",
//     "taken_at": "...", "done_at": "...", "note": "...",
//     "driver_ref": "<Ref_Key физлица-водителя>" | null, "vehicle_ref": "<Ref_Key транспортного средства>" | null,
//     "file_name": "Доставка БКНФ-008275 1729160000000.jpg" | null,
//     "file_base64": "<jpeg>" | null }
//   → 200 { "ok": true, "status_set": true, "file": "added|exists|none" }
//
// Что делает в 1С:
//   1. Записывает дополнительный реквизит (или сведение) «Статус доставки» = «В пути» /
//      «Доставлено» / «Возврат» / пусто, и — если создан — «Доставка: детали»
//      (водитель, время, примечание). Движения документа НЕ меняются.
//   2. Заполняет в документе стандартные «Водитель» и «Автомобиль» («Подписи и другие реквизиты» →
//      «Перевозка») — по ним в конце месяца считают доставки каждого экспедитора.
//      «Ожидает» (водитель отказался / админ сбросил) — очищает их.
//   3. Прикрепляет фото подписанной накладной к документу (кнопка «Файлы» / скрепка).
//      Повторная отправка того же файла не создаёт дубль (поиск по имени файла).
//
// Второй шаблон того же сервиса — «Сеть» контрагента:
//   POST /hs/nstore_delivery/chain
//   { "items": [ { "ref": "<Ref_Key контрагента>", "chain": "Espresso Day" | "" }, ... ] }
//   → 200 { "ok": true, "results": [ { "ref": "...", "ok": true } | { "ref": "...", "ok": false, "error": "..." } ] }
//   Заполняет доп. реквизит контрагента «Сеть» (тип «Дополнительное значение»); значение списка
//   подбирается по наименованию, при отсутствии создаётся. Пустое "chain" — очистить.
//   Шаблон: имя «Сеть», шаблон «/chain», метод POST, обработчик «СетьPOST».
//
// Ещё два шаблона (контрагенты из CRM):
//   «Контакт»    шаблон «/contact»       метод POST, обработчик «КонтактPOST»    — контактные лица контрагента
//   «Контрагент» шаблон «/counterparty»  метод POST, обработчик «КонтрагентPOST» — наименование / телефон
//
// ─────────────────────────────── УСТАНОВКА ───────────────────────────────
//  1. Конфигуратор → Конфигурация → Расширения конфигурации → Добавить:
//     Имя «nStoreДоставка», Назначение «Адаптация», Префикс «нс_».
//  2. В дереве расширения: HTTP-сервисы → Добавить:
//       Имя: нс_Доставка        Корневой URL: nstore_delivery
//     URL-шаблоны → Добавить: Имя «Статус», Шаблон «/status»
//       Методы → Добавить: Имя «POST», HTTP-метод POST, Обработчик «СтатусPOST».
//     Вставьте весь код ниже в модуль HTTP-сервиса.
//  3. Обновить конфигурацию БД (F7). В режиме Предприятия:
//     Администрирование → Печатные формы, отчёты и обработки → Расширения →
//     у «nStoreДоставка» снять флажки «Безопасный режим» и «Защита от опасных действий»
//     (нужно для привилегированного режима записи статуса и файла).
//  4. Публикация: Администрирование → Публикация на веб-сервере → отметить
//     «Публиковать HTTP-сервисы расширений по умолчанию» (или в default.vrd
//     <httpServices publishExtensionsByDefault="true"/>) → Опубликовать.
//     Проверка: https://unf.nstore.keenetic.pro/UN_JJCO/hs/nstore_delivery/status
//     (GET вернёт 405 — это нормально, значит сервис опубликован).
//  5. НСИ и администрирование → Общие настройки → Дополнительные реквизиты и сведения →
//     «Расходная накладная» → Добавить → Новый:
//       Наименование «Статус доставки», Тип значения «Строка (50)».
//     Можно тип «Дополнительное значение» (выбор из списка) со значениями «В пути»,
//     «Доставлено», «Возврат» — модуль подберёт значение по наименованию (или создаст).
//     По желанию второй: «Доставка: детали», Строка (неограниченная).
//     Колонку «Статус доставки» можно вывести в список накладных: Ещё → Изменить форму.
//  6. Пользователь, под которым ходит nStore (тот же, что для OData), должен иметь право
//     на вход через HTTP-сервисы (роль «Удалённый доступ: базовая функциональность»/
//     «Подсистема ... интеграция» — в УНФ достаточно профиля «Администратор» или
//     отдельного профиля с правом «Внешнее соединение»).
// ─────────────────────────────────────────────────────────────────────────

Функция СтатусPOST(Запрос)
	Попытка
		Данные = ПрочитатьТело(Запрос);
		Результат = ОбработатьСтатус(Данные);
		Возврат ОтветJSON(200, Результат);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Текст = КраткоеПредставлениеОшибки(Инфо);
		ЗаписьЖурналаРегистрации("nStore.Доставка", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(Инфо));
		Ошибка = Новый Структура("ok, error", Ложь, Текст);
		Возврат ОтветJSON(200, Ошибка); // 200 + ok=false — чтобы nStore отличал от «сервис не найден» (404)
	КонецПопытки;
КонецФункции

Функция СетьPOST(Запрос)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		УстановитьПривилегированныйРежим(Истина);

		Свойство = НайтиСвойство("Сеть", "Контрагент");
		Если Свойство = Неопределено Тогда
			ВызватьИсключение "В 1С не создан дополнительный реквизит «Сеть» для контрагентов";
		КонецЕсли;

		Результаты = Новый Массив;
		Для Каждого Эл Из Данные.Получить("items") Цикл
			Ref = Строка(Эл.Получить("ref"));
			Сеть = СокрЛП(Строка(?(Эл.Получить("chain") = Неопределено, "", Эл.Получить("chain"))));
			Попытка
				Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Ref));
				Если НЕ ЗначениеЗаполнено(Ссылка.Наименование) Тогда
					ВызватьИсключение "Контрагент не найден";
				КонецЕсли;
				Значения = Новый Соответствие;
				Значения.Вставить(Свойство, Сеть);
				ЗаписатьСвойстваОбъекта(Ссылка, "Справочник.Контрагенты", Значения);
				Результаты.Добавить(Новый Структура("ref, ok, chain", Ref, Истина, Сеть));
			Исключение
				Результаты.Добавить(Новый Структура("ref, ok, chain, error", Ref, Ложь, Сеть,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
		Возврат ОтветJSON(200, Новый Структура("ok, results", Истина, Результаты));
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("nStore.Сеть", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Инфо));
		Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, КраткоеПредставлениеОшибки(Инфо)));
	КонецПопытки;
КонецФункции

// ───────────── Контактные лица контрагента (CRM → 1С) ─────────────
// POST /contact  { "items": [ { "id": "<uuid контакта CRM>", "counterparty_ref": "...", "contact_ref": "..." | null,
//                              "name": "...", "phone": "...", "email": "...", "role": "..." } ] }
// → { "ok": true, "results": [ { "id": "...", "ok": true, "contact_ref": "<Ref_Key КонтактногоЛица>" } ] }
// counterparty_ref может быть null — контактное лицо без контрагента.
// Если contact_ref не передан — ищет контактное лицо с тем же телефоном или с тем же именем у контрагента (без дублей),
// иначе создаёт. Привязка к контрагенту — регистр сведений связи контрагент ↔ контакт (ищется по типам измерений).
Функция КонтактPOST(Запрос)
	Попытка
		Данные = ПрочитатьСписок(Запрос);
		УстановитьПривилегированныйРежим(Истина);
		Телефоны = ТелефоныКонтактов();
		Результаты = Новый Массив;
		Для Каждого Эл Из Данные Цикл
			Ид = Строка(Эл.Получить("id"));
			Попытка
				Ссылка = ЗаписатьКонтактноеЛицо(Эл, Телефоны);
				Результаты.Добавить(Новый Структура("id, ok, contact_ref", Ид, Истина, Строка(Ссылка.УникальныйИдентификатор())));
			Исключение
				Результаты.Добавить(Новый Структура("id, ok, error", Ид, Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
		Возврат ОтветJSON(200, Новый Структура("ok, results", Истина, Результаты));
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("nStore.Контакт", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Инфо));
		Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, КраткоеПредставлениеОшибки(Инфо)));
	КонецПопытки;
КонецФункции

Функция ЗаписатьКонтактноеЛицо(Эл, Телефоны)
	// counterparty_ref может быть пустым — тогда контактное лицо без контрагента
	Контрагент = Неопределено;
	Если ЗначениеЗаполнено(Эл.Получить("counterparty_ref")) Тогда
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(Эл.Получить("counterparty_ref"))));
		Если НЕ ЗначениеЗаполнено(Контрагент.Наименование) Тогда
			ВызватьИсключение "Контрагент не найден в 1С (удалён или объединён)";
		КонецЕсли;
	КонецЕсли;
	Имя = СокрЛП(Строка(?(Эл.Получить("name") = Неопределено, "", Эл.Получить("name"))));
	Если Имя = "" Тогда
		Имя = СокрЛП(Строка(?(Эл.Получить("phone") = Неопределено, "Контакт", Эл.Получить("phone"))));
	КонецЕсли;
	Роль = СокрЛП(Строка(?(Эл.Получить("role") = Неопределено, "", Эл.Получить("role"))));
	Связь = ?(Контрагент = Неопределено, Неопределено, РегистрСвязиКонтрагентКонтакт());

	Ссылка = Справочники.КонтактныеЛица.ПустаяСсылка();
	Если ЗначениеЗаполнено(Эл.Получить("contact_ref")) Тогда
		Ссылка = Справочники.КонтактныеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(Эл.Получить("contact_ref"))));
		Если НЕ ЗначениеЗаполнено(Ссылка.Наименование) Тогда
			Ссылка = Справочники.КонтактныеЛица.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	// без дублей: контакт с тем же номером телефона (последние 10 цифр)
	Цифры = Прав(ТолькоЦифры(Эл.Получить("phone")), 10);
	Если НЕ ЗначениеЗаполнено(Ссылка) И СтрДлина(Цифры) = 10 И Телефоны.Получить(Цифры) <> Неопределено Тогда
		Ссылка = Телефоны.Получить(Цифры);
	КонецЕсли;
	// без дублей: контакт с таким же именем, уже связанный с этим контрагентом
	Если НЕ ЗначениеЗаполнено(Ссылка) И Связь <> Неопределено Тогда
		Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Р.%2 КАК Ссылка
		|ИЗ РегистрСведений.%1 КАК Р
		|ГДЕ Р.%3 = &Контрагент И Р.%2.Наименование = &Имя И НЕ Р.%2.ПометкаУдаления",
			Связь.Имя, Связь.Контакт, Связь.Контрагент));
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Имя", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ссылка = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.КонтактныеЛица.СоздатьЭлемент());
	Объект.Наименование = Имя;
	УстановитьКонтакт(Объект, "9a002751-81fb-11ed-99cd-b48c9d55801d", Эл.Получить("phone"));
	УстановитьКонтакт(Объект, "9a00274d-81fb-11ed-99cd-b48c9d55801d", Эл.Получить("email"));
	Объект.Записать();

	Если СтрДлина(Цифры) = 10 Тогда
		Телефоны.Вставить(Цифры, Объект.Ссылка);
	КонецЕсли;
	Если Контрагент = Неопределено Тогда
		Возврат Объект.Ссылка; // контакт без контрагента
	КонецЕсли;
	Если Связь = Неопределено Тогда
		ВызватьИсключение "Контакт создан, но в конфигурации не найден регистр связи контрагент ↔ контактное лицо";
	КонецЕсли;
	// связь уже есть — обновляем роль в последней записи, иначе добавляем запись
	Набор = РегистрыСведений[Связь.Имя].СоздатьНаборЗаписей();
	Набор.Отбор[Связь.Контрагент].Установить(Контрагент);
	Набор.Отбор[Связь.Контакт].Установить(Объект.Ссылка);
	Набор.Прочитать();
	Периодический = Метаданные.РегистрыСведений[Связь.Имя].ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	Если Набор.Количество() = 0 Тогда
		Запись = Набор.Добавить();
		Если Периодический Тогда
			Запись.Период = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
		Запись[Связь.Контрагент] = Контрагент;
		Запись[Связь.Контакт] = Объект.Ссылка;
	Иначе
		Запись = Набор[Набор.Количество() - 1];
	КонецЕсли;
	Если Роль <> "" Тогда
		Для Каждого ИмяПоля Из СтрРазделить("Должность,ОписаниеСвязи,Описание", ",") Цикл
			Если Связь.Поля.Найти(ИмяПоля) <> Неопределено Тогда
				Попытка
					Запись[ИмяПоля] = Роль;
				Исключение
				КонецПопытки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Связь.Поля.Найти("СвязьНедействительна") <> Неопределено Тогда
		Запись.СвязьНедействительна = Ложь;
	КонецЕсли;
	Набор.Записать(Истина);
	Возврат Объект.Ссылка;
КонецФункции

// Все телефоны контактных лиц: последние 10 цифр → ссылка (для поиска дублей)
Функция ТелефоныКонтактов()
	Телефоны = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Представление КАК Представление
	|ИЗ Справочник.КонтактныеЛица.КонтактнаяИнформация КАК К
	|ГДЕ НЕ К.Ссылка.ПометкаУдаления И К.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ц = Прав(ТолькоЦифры(Выборка.Представление), 10);
		Если СтрДлина(Ц) = 10 И Телефоны.Получить(Ц) = Неопределено Тогда
			Телефоны.Вставить(Ц, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Телефоны;
КонецФункции

Функция ТолькоЦифры(Значение)
	Текст = Строка(?(Значение = Неопределено, "", Значение));
	Ц = "";
	Для Н = 1 По СтрДлина(Текст) Цикл
		С = Сред(Текст, Н, 1);
		Если СтрНайти("0123456789", С) > 0 Тогда Ц = Ц + С; КонецЕсли;
	КонецЦикла;
	Возврат Ц;
КонецФункции

// Регистр сведений, у которого среди измерений есть Контрагент и КонтактноеЛицо
// (в УНФ 3.0 — «СвязиКонтрагентКонтакт»). Структура: Имя, Контрагент, Контакт (имена измерений), Поля (массив прочих полей).
Функция РегистрСвязиКонтрагентКонтакт()
	ТипКонтрагент = Тип("СправочникСсылка.Контрагенты");
	ТипКонтакт = Тип("СправочникСсылка.КонтактныеЛица");
	Для Каждого Рег Из Метаданные.РегистрыСведений Цикл
		ИзмК = ""; ИзмЛ = "";
		Для Каждого Изм Из Рег.Измерения Цикл
			Если Изм.Тип.Типы().Количество() = 1 И Изм.Тип.СодержитТип(ТипКонтрагент) Тогда
				ИзмК = Изм.Имя;
			ИначеЕсли Изм.Тип.Типы().Количество() = 1 И Изм.Тип.СодержитТип(ТипКонтакт) Тогда
				ИзмЛ = Изм.Имя;
			КонецЕсли;
		КонецЦикла;
		Если ИзмК <> "" И ИзмЛ <> "" Тогда
			Поля = Новый Массив;
			Для Каждого Р Из Рег.Ресурсы Цикл Поля.Добавить(Р.Имя); КонецЦикла;
			Для Каждого Р Из Рег.Реквизиты Цикл Поля.Добавить(Р.Имя); КонецЦикла;
			Возврат Новый Структура("Имя, Контрагент, Контакт, Поля", Рег.Имя, ИзмК, ИзмЛ, Поля);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// ───────────── Правка контрагента (CRM → 1С): наименование, телефон ─────────────
// POST /counterparty { "items": [ { "ref": "...", "name": "..." | null, "full_name": "..." | null, "phone": "..." | null } ] }
// → { "ok": true, "results": [ { "ref": "...", "ok": true } ] }
Функция КонтрагентPOST(Запрос)
	Попытка
		Данные = ПрочитатьСписок(Запрос);
		УстановитьПривилегированныйРежим(Истина);
		ВидТелефона = Неопределено;
		Попытка
			ВидТелефона = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонКонтрагента");
		Исключение
		КонецПопытки;
		Результаты = Новый Массив;
		Для Каждого Эл Из Данные Цикл
			Ref = Строка(Эл.Получить("ref"));
			Попытка
				Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Ref));
				Если НЕ ЗначениеЗаполнено(Ссылка.Наименование) Тогда
					ВызватьИсключение "Контрагент не найден";
				КонецЕсли;
				Объект = Ссылка.ПолучитьОбъект();
				Если ЗначениеЗаполнено(Эл.Получить("name")) Тогда
					Объект.Наименование = СокрЛП(Эл.Получить("name"));
				КонецЕсли;
				Если ЗначениеЗаполнено(Эл.Получить("full_name")) Тогда
					Объект.НаименованиеПолное = СокрЛП(Эл.Получить("full_name"));
				КонецЕсли;
				Если ЗначениеЗаполнено(Эл.Получить("phone")) И ВидТелефона <> Неопределено Тогда
					УстановитьКонтакт(Объект, ВидТелефона, Эл.Получить("phone"));
				КонецЕсли;
				Объект.Записать();
				Результаты.Добавить(Новый Структура("ref, ok", Ref, Истина));
			Исключение
				Результаты.Добавить(Новый Структура("ref, ok, error", Ref, Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
		Возврат ОтветJSON(200, Новый Структура("ok, results", Истина, Результаты));
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("nStore.Контрагент", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Инфо));
		Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, КраткоеПредставлениеОшибки(Инфо)));
	КонецПопытки;
КонецФункции

// Вид — ссылка на вид КИ или строка GUID. Пустое значение — ничего не меняет.
Процедура УстановитьКонтакт(Объект, Вид, Значение)
	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если Текст = "" Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Вид) = Тип("Строка") Тогда
		Вид = Справочники.ВидыКонтактнойИнформации.ПолучитьСсылку(Новый УникальныйИдентификатор(Вид));
	КонецЕсли;
	Попытка
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, Текст, Вид, , Истина);
	Исключение
		// БСП без этого метода — пишем в табличную часть напрямую
		Стр = Объект.КонтактнаяИнформация.Найти(Вид, "Вид");
		Если Стр = Неопределено Тогда
			Стр = Объект.КонтактнаяИнформация.Добавить();
			Стр.Вид = Вид;
			Стр.Тип = Вид.Тип;
		КонецЕсли;
		Стр.Представление = Текст;
	КонецПопытки;
КонецПроцедуры

Функция ПрочитатьСписок(Запрос)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Соответствие") ИЛИ ТипЗнч(Данные.Получить("items")) <> Тип("Массив") Тогда
		ВызватьИсключение "Ожидается JSON с полем items";
	КонецЕсли;
	Возврат Данные.Получить("items");
КонецФункции

// Доп. реквизиты/сведения любого справочника (без изменения прочих данных).
Процедура ЗаписатьСвойстваОбъекта(Ссылка, ИмяТаблицы, Значения)
	Приведенные = Новый Соответствие;
	Для Каждого КЗ Из Значения Цикл
		Приведенные.Вставить(КЗ.Ключ, ЗначениеДляСвойства(КЗ.Ключ, КЗ.Значение));
	КонецЦикла;

	Реквизиты = Новый Соответствие;
	Для Каждого КЗ Из Приведенные Цикл
		Если КЗ.Ключ.ЭтоДополнительноеСведение Тогда
			Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Ссылка);
			Набор.Отбор.Свойство.Установить(КЗ.Ключ);
			Если ЗначениеЗаполнено(КЗ.Значение) Тогда
				Запись = Набор.Добавить();
				Запись.Объект = Ссылка; Запись.Свойство = КЗ.Ключ; Запись.Значение = КЗ.Значение;
			КонецЕсли;
			Набор.Записать(Истина);
		Иначе
			Реквизиты.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Реквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(ИмяТаблицы);
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Объект = Ссылка.ПолучитьОбъект();
		ЕстьТекстоваяСтрока = Объект.Метаданные().ТабличныеЧасти.ДополнительныеРеквизиты.Реквизиты.Найти("ТекстоваяСтрока") <> Неопределено;
		Изменен = Ложь;
		Для Каждого КЗ Из Реквизиты Цикл
			Строки = Объект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", КЗ.Ключ));
			Если НЕ ЗначениеЗаполнено(КЗ.Значение) Тогда
				Для Каждого Стр Из Строки Цикл
					Объект.ДополнительныеРеквизиты.Удалить(Стр);
					Изменен = Истина;
				КонецЦикла;
			Иначе
				Стр = ?(Строки.Количество() > 0, Строки[0], Объект.ДополнительныеРеквизиты.Добавить());
				Если Стр.Свойство <> КЗ.Ключ ИЛИ Стр.Значение <> КЗ.Значение Тогда
					Стр.Свойство = КЗ.Ключ;
					Стр.Значение = КЗ.Значение;
					Если ЕстьТекстоваяСтрока И ТипЗнч(КЗ.Значение) = Тип("Строка") Тогда
						Стр.ТекстоваяСтрока = Лев(КЗ.Значение, 1024);
					КонецЕсли;
					Изменен = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Изменен Тогда
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция ОбработатьСтатус(Данные)
	УстановитьПривилегированныйРежим(Истина);

	Ссылка = Документы.РасходнаяНакладная.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(Данные.Получить("ref"))));
	Если НЕ ЗначениеЗаполнено(Ссылка.Номер) Тогда // битая ссылка — документа нет
		ВызватьИсключение "Накладная не найдена: " + Строка(Данные.Получить("number"));
	КонецЕсли;

	КодСтатуса = Строка(Данные.Получить("status"));
	ПредставлениеСтатуса = ПредставлениеСтатуса(КодСтатуса);
	Детали = ТекстДеталей(Данные, ПредставлениеСтатуса);

	СвойствоСтатус = НайтиСвойство("Статус доставки");
	Если СвойствоСтатус = Неопределено Тогда
		ВызватьИсключение "В 1С не создан дополнительный реквизит «Статус доставки» для расходной накладной";
	КонецЕсли;
	СвойствоДетали = НайтиСвойство("Доставка: детали");

	Значения = Новый Соответствие;
	Значения.Вставить(СвойствоСтатус, ПредставлениеСтатуса);
	Если СвойствоДетали <> Неопределено Тогда
		Значения.Вставить(СвойствоДетали, Детали);
	КонецЕсли;
	Шапка = Новый Структура;
	Если ПредставлениеСтатуса = "" Тогда
		Шапка.Вставить("Водитель", Неопределено);   // очистить
		Шапка.Вставить("Автомобиль", Неопределено);
	Иначе
		Если ЗначениеЗаполнено(Данные.Получить("driver_ref")) Тогда
			Шапка.Вставить("Водитель", Строка(Данные.Получить("driver_ref")));
		КонецЕсли;
		Если ЗначениеЗаполнено(Данные.Получить("vehicle_ref")) Тогда
			Шапка.Вставить("Автомобиль", Строка(Данные.Получить("vehicle_ref")));
		КонецЕсли;
	КонецЕсли;
	ЗаписатьСвойства(Ссылка, Значения, Шапка);

	РезультатФайла = "none";
	ДвоичныйBase64 = Данные.Получить("file_base64");
	Если ЗначениеЗаполнено(ДвоичныйBase64) Тогда
		РезультатФайла = ПрикрепитьФото(Ссылка, Строка(Данные.Получить("file_name")), ДвоичныйBase64,
			"Фото подписанной накладной. " + Детали);
	КонецЕсли;

	Возврат Новый Структура("ok, status_set, file", Истина, Истина, РезультатФайла);
КонецФункции

Функция ПредставлениеСтатуса(Код)
	Если Код = "taken" Тогда
		Возврат "В пути";
	ИначеЕсли Код = "delivered" Тогда
		Возврат "Доставлено";
	ИначеЕсли Код = "returned" Тогда
		Возврат "Возврат";
	Иначе
		Возврат ""; // waiting — водитель отказался / админ сбросил
	КонецЕсли;
КонецФункции

Функция ТекстДеталей(Данные, ПредставлениеСтатуса)
	Если ПредставлениеСтатуса = "" Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить(ПредставлениеСтатуса);
	Водитель = Данные.Получить("driver");
	Если ЗначениеЗаполнено(Водитель) Тогда
		Части.Добавить("водитель " + Водитель);
	КонецЕсли;
	Когда = Данные.Получить("done_at");
	Если НЕ ЗначениеЗаполнено(Когда) Тогда
		Когда = Данные.Получить("taken_at");
	КонецЕсли;
	Если ЗначениеЗаполнено(Когда) Тогда
		Части.Добавить(ВремяАстаны(Строка(Когда)));
	КонецЕсли;
	Примечание = Данные.Получить("note");
	Если ЗначениеЗаполнено(Примечание) Тогда
		Части.Добавить(Примечание);
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

// "2026-10-17T09:32:10.123+00:00" → "17.10.2026 14:32" (UTC+5)
Функция ВремяАстаны(ISO)
	Попытка
		С = Лев(СтрЗаменить(СтрЗаменить(СтрЗаменить(ISO, "-", ""), ":", ""), "T", ""), 14);
		Дата = Дата(С) + 5 * 3600;
		Возврат Формат(Дата, "ДФ='дд.ММ.гггг ЧЧ:мм'");
	Исключение
		Возврат ISO;
	КонецПопытки;
КонецФункции

// Дополнительный реквизит/сведение по наименованию (ПВХ БСП ДополнительныеРеквизитыИСведения).
Функция НайтиСвойство(Наименование, ПодсказкаНабора = "Расходн")
	// В БСП Наименование = «Заголовок (Набор)», поэтому ищем по заголовку или префиксу наименования;
	// если таких несколько — предпочитаем свойство из набора расходной накладной.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	С.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления
	|	И (С.Заголовок = &Имя ИЛИ С.Наименование = &Имя ИЛИ С.Наименование ПОДОБНО &Шаблон)
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР КОГДА С.НаборСвойств.Наименование ПОДОБНО &Набор ТОГДА 0 ИНАЧЕ 1 КОНЕЦ");
	Запрос.УстановитьПараметр("Набор", "%" + ПодсказкаНабора + "%");
	Запрос.УстановитьПараметр("Шаблон", Наименование + " (%");
	Запрос.УстановитьПараметр("Имя", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Сведения → регистр ДополнительныеСведения (документ не перезаписывается).
// Реквизиты → табличная часть ДополнительныеРеквизиты, запись в режиме загрузки
// (без перепроведения и проверок; проведение и движения остаются как были).
// Шапка — Структура «Реквизит документа → GUID строкой | Неопределено (очистить)».
Процедура ЗаписатьСвойства(Ссылка, Значения, Шапка)
	// Тип реквизита «Строка» — пишем текст; «Дополнительное значение» (выбор из списка) —
	// подбираем элемент списка с таким наименованием, при отсутствии создаём его.
	Приведенные = Новый Соответствие;
	Для Каждого КЗ Из Значения Цикл
		Приведенные.Вставить(КЗ.Ключ, ЗначениеДляСвойства(КЗ.Ключ, КЗ.Значение));
	КонецЦикла;
	Значения = Приведенные;

	Реквизиты = Новый Соответствие;
	Для Каждого КЗ Из Значения Цикл
		Если КЗ.Ключ.ЭтоДополнительноеСведение Тогда
			Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Ссылка);
			Набор.Отбор.Свойство.Установить(КЗ.Ключ);
			Если ЗначениеЗаполнено(КЗ.Значение) Тогда
				Запись = Набор.Добавить();
				Запись.Объект = Ссылка;
				Запись.Свойство = КЗ.Ключ;
				Запись.Значение = КЗ.Значение;
			КонецЕсли;
			Набор.Записать(Истина);
		Иначе
			Реквизиты.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Реквизиты.Количество() = 0 И Шапка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Документ.РасходнаяНакладная");
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Объект = Ссылка.ПолучитьОбъект();
		ЕстьТекстоваяСтрока = Объект.Метаданные().ТабличныеЧасти.ДополнительныеРеквизиты.Реквизиты.Найти("ТекстоваяСтрока") <> Неопределено;
		Изменен = Ложь;
		Для Каждого КЗ Из Реквизиты Цикл
			Строки = Объект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", КЗ.Ключ));
			Если НЕ ЗначениеЗаполнено(КЗ.Значение) Тогда
				Для Каждого Стр Из Строки Цикл
					Объект.ДополнительныеРеквизиты.Удалить(Стр);
					Изменен = Истина;
				КонецЦикла;
			Иначе
				Стр = ?(Строки.Количество() > 0, Строки[0], Объект.ДополнительныеРеквизиты.Добавить());
				Если Стр.Свойство <> КЗ.Ключ ИЛИ Стр.Значение <> КЗ.Значение Тогда
					Стр.Свойство = КЗ.Ключ;
					Стр.Значение = КЗ.Значение;
					Если ЕстьТекстоваяСтрока И ТипЗнч(КЗ.Значение) = Тип("Строка") Тогда
						Стр.ТекстоваяСтрока = Лев(КЗ.Значение, 1024);
					КонецЕсли;
					Изменен = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		МетаРеквизиты = Объект.Метаданные().Реквизиты;
		Для Каждого КЗ Из Шапка Цикл
			МетаРеквизит = МетаРеквизиты.Найти(КЗ.Ключ);
			Если МетаРеквизит = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Новое = МетаРеквизит.Тип.ПривестиЗначение(Неопределено);   // пустая ссылка нужного типа
			Если КЗ.Значение <> Неопределено Тогда
				МетаСправочник = Метаданные.НайтиПоТипу(МетаРеквизит.Тип.Типы()[0]);
				Новое = Справочники[МетаСправочник.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(КЗ.Значение));
			КонецЕсли;
			Если Объект[КЗ.Ключ] <> Новое Тогда
				Объект[КЗ.Ключ] = Новое;
				Изменен = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Изменен Тогда
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Текст → значение нужного типа: строка как есть; для списка значений (ЗначенияСвойствОбъектов
// и ЗначенияСвойствОбъектовИерархия) — элемент с этим наименованием, при отсутствии создаётся.
Функция ЗначениеДляСвойства(Свойство, Текст)
	Если Текст = "" Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Т Из Свойство.ТипЗначения.Типы() Цикл
		Мета = Метаданные.НайтиПоТипу(Т);
		Если Мета = Неопределено ИЛИ НЕ Метаданные.Справочники.Содержит(Мета)
			ИЛИ СтрНайти(Мета.Имя, "ЗначенияСвойствОбъектов") <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка КАК Ссылка
		|ИЗ Справочник." + Мета.Имя + " КАК З
		|ГДЕ З.Владелец = &Свойство И З.Наименование = &Текст И НЕ З.ПометкаУдаления");
		Запрос.УстановитьПараметр("Свойство", Свойство);
		Запрос.УстановитьПараметр("Текст", Текст);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Элемент = Справочники[Мета.Имя].СоздатьЭлемент();
		Элемент.Владелец = Свойство;
		Элемент.Наименование = Текст;
		Элемент.Записать();
		Возврат Элемент.Ссылка;
	КонецЦикла;
	Возврат Текст;
КонецФункции

// Присоединённый файл (БСП «Работа с файлами»). Идемпотентно — по имени файла.
Функция ПрикрепитьФото(Ссылка, ИмяФайла, Base64, Описание)
	ИмяБезРасширения = ИмяФайла;
	Расширение = "jpg";
	Поз = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если Поз > 0 Тогда
		ИмяБезРасширения = Лев(ИмяФайла, Поз - 1);
		Расширение = НРег(Сред(ИмяФайла, Поз + 1));
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Ссылка
	|ИЗ Справочник.РасходнаяНакладнаяПрисоединенныеФайлы КАК Ф
	|ГДЕ Ф.ВладелецФайла = &Владелец И Ф.Наименование = &Имя И НЕ Ф.ПометкаУдаления");
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	Запрос.УстановитьПараметр("Имя", ИмяБезРасширения);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат "exists";
	КонецЕсли;

	Двоичные = Base64Значение(Base64);
	Если Двоичные = Неопределено ИЛИ Двоичные.Размер() = 0 Тогда
		ВызватьИсключение "Пустое или повреждённое фото";
	КонецЕсли;
	Адрес = ПоместитьВоВременноеХранилище(Двоичные, Новый УникальныйИдентификатор);

	Параметры = РаботаСФайлами.ПараметрыДобавленияФайла();
	Параметры.ВладелецФайлов = Ссылка;
	Параметры.ИмяБезРасширения = ИмяБезРасширения;
	Параметры.РасширениеБезТочки = Расширение;
	Параметры.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
	РаботаСФайлами.ДобавитьФайл(Параметры, Адрес, , Описание);
	УдалитьИзВременногоХранилища(Адрес);
	Возврат "added";
КонецФункции

Функция ПрочитатьТело(Запрос)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Соответствие") ИЛИ НЕ ЗначениеЗаполнено(Данные.Получить("ref")) Тогда
		ВызватьИсключение "Ожидается JSON с полем ref";
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ОтветJSON(Код, Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции
